{
  "name": "onda-vscode",
  "displayName": "Onda",
  "description": "VS Code support for the Onda audio DSL",
  "version": "0.1.39",
  "publisher": "onda-lang",
  "icon": "assets/png/onda-logo-dark-rect.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/onda-lang/onda-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:onda",
    "onCommand:onda.restartLanguageServer",
    "onCommand:onda.runFile",
    "onCommand:onda.runFileWithFastMath",
    "onCommand:onda.createProject",
    "onCommand:onda.saveAsProject",
    "onCommand:onda.stopFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "onda",
        "aliases": [
          "Onda",
          "onda"
        ],
        "extensions": [
          ".onda",
          ".on"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".ondaproject"
        ]
      }
    ],
    "grammars": [
      {
        "language": "onda",
        "scopeName": "source.onda",
        "path": "./syntaxes/onda.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "port",
        "superType": "variable",
        "description": "Onda audio input, output, or buffer symbol"
      },
      {
        "id": "state",
        "superType": "variable",
        "description": "Onda init-declared state symbol"
      },
      {
        "id": "delegate",
        "superType": "event",
        "description": "Onda output event declaration or call"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "onda",
        "scopes": {
          "enumMember": [
            "variable.other.constant"
          ],
          "variable": [
            "variable.other.readwrite"
          ],
          "port": [
            "support.variable"
          ],
          "state": [
            "variable.parameter"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "function": [
            "entity.name.function"
          ],
          "event": [
            "entity.name.function"
          ],
          "delegate": [
            "entity.name.function"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "onda.runFile",
        "title": "Onda: Run",
        "icon": "$(play)"
      },
      {
        "command": "onda.runFileWithFastMath",
        "title": "Onda: Run with Fast Math"
      },
      {
        "command": "onda.createProject",
        "title": "Onda: Create Project\u2026"
      },
      {
        "command": "onda.saveAsProject",
        "title": "Onda: Save as Project\u2026",
        "icon": "$(save-as)"
      },
      {
        "command": "onda.stopFile",
        "title": "Onda: Stop"
      },
      {
        "command": "onda.restartLanguageServer",
        "title": "Onda: Restart Language Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "onda.runFile",
          "when": "resourceExtname == .onda || resourceExtname == .on || resourceExtname == .ondaproject",
          "group": "navigation@1"
        },
        {
          "command": "onda.saveAsProject",
          "when": "resourceExtname == .onda || resourceExtname == .on",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "onda.runFile",
          "when": "resourceExtname == .onda || resourceExtname == .on || resourceExtname == .ondaproject",
          "group": "navigation@1"
        },
        {
          "command": "onda.runFileWithFastMath",
          "when": "resourceExtname == .onda || resourceExtname == .on || resourceExtname == .ondaproject",
          "group": "navigation@1"
        },
        {
          "command": "onda.saveAsProject",
          "when": "resourceExtname == .onda || resourceExtname == .on",
          "group": "navigation@2"
        },
        {
          "command": "onda.createProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@3"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.ondaproject",
        "url": "./schemas/project.json"
      }
    ],
    "configuration": {
      "title": "Onda",
      "properties": {
        "onda.exec.path": {
          "type": "string",
          "scope": "window",
          "ignoreSync": true,
          "description": "Path to the external Onda executable for this VS Code window when onda.compiler.source is external. Set in User or Workspace settings; folder overrides are unsupported. Leave unset to use 'onda' from PATH."
        },
        "onda.exec.args": {
          "type": "array",
          "scope": "window",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to the selected Onda compiler before each built-in subcommand. Applies to the whole VS Code window."
        },
        "onda.run.theme": {
          "type": ["string", "null"],
          "enum": [
            null,
            "dark",
            "light"
          ],
          "enumItemLabels": ["Detect at startup", "Dark", "Light"],
          "default": null,
          "description": "Theme used by the Onda run panel. When unset, detect the VS Code appearance when the panel opens."
        },
        "onda.run.sampleRate": {
          "type": "integer",
          "minimum": 1,
          "default": 48000,
          "description": "Sample rate in Hz used by Onda: Run. Only passed to Onda when explicitly configured."
        },
        "onda.run.blockSize": {
          "type": "integer",
          "minimum": 1,
          "default": 512,
          "description": "Compile block size in frames used by Onda: Run. Only passed to Onda when explicitly configured."
        },
        "onda.compiler.source": {
          "type": "string",
          "enum": [
            "bundled",
            "external"
          ],
          "enumDescriptions": [
            "Use the Onda compiler included with this extension.",
            "Use onda.exec.path when configured, otherwise find onda on PATH."
          ],
          "default": "bundled",
          "scope": "window",
          "ignoreSync": true,
          "description": "Compiler used for language services, playback, and project commands throughout this VS Code window. Set in User or Workspace settings; folder overrides are unsupported. Changing this restarts the language server and stops active playback."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('./out',{recursive:true,force:true})\"",
    "copy-run-ui": "node ./scripts/copy-run-ui.mjs",
    "compile": "npm run clean && tsc -p ./ && npm run copy-run-ui",
    "bundle": "node ./scripts/bundle-extension.mjs",
    "test": "npm run compile && node --test ./test/*.test.js",
    "vscode:prepublish": "node ./scripts/verify-compiler.mjs --packaging && npm run compile && npm run bundle",
    "watch": "node ./scripts/watch.mjs",
    "stage:gpu": "node ./scripts/stage-gpu-ui.mjs",
    "test:gpu-host": "node ./scripts/test-gpu-host.mjs",
    "package:gpu": "node ./scripts/package-gpu.mjs",
    "stage:compiler": "node ./scripts/stage-compiler.mjs",
    "verify:compiler": "node ./scripts/verify-compiler.mjs",
    "test:compiler": "node ./scripts/test-bundled-compiler.mjs",
    "test:integration": "npm run compile && node ./scripts/test-run-integration.mjs",
    "package:embedded": "node ./scripts/package-embedded.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "extensionKind": [
    "workspace"
  ]
}
